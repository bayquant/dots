{
    // This configuration targets a virtual environment named .venv
    // located in the parent directory of the workspace (../.venv).

    // Path to the Python interpreter inside the virtual environment
    // On Windows use: "${workspaceFolder}/../venv/Scripts/python.exe"
    "python.defaultInterpreterPath": "${workspaceFolder}/../.venv/bin/python",
    // Auto-activate the virtual environment in the integrated terminal
    "python.terminal.activateEnvironment": true,
    "terminal.integrated.env.windows": {
        // Marks the active virtual environment for tools like pip
        "VIRTUAL_ENV": "${workspaceFolder}/../.venv",
        // Prepend venv Scripts so venv executables take precedence
        "PATH": "${workspaceFolder}/../venv/Scripts;${env:PATH}",
        // Allow imports from the project root without installing the package
        "PYTHONPATH": "${workspaceFolder}"
    }
}
