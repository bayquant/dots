# Print the BayQuant mascot (a blue cube with eyes) with the name beside it.
# Source this from ~/.zshrc to show it on every new terminal.
print -P '  %K{117}          %k'
print -P ' %K{117}          %K{25} %k'
print -P '%K{33}          %K{25}  %k'
print -P '%K{33}  %K{231}  %K{33}  %K{231}  %K{33}  %K{25}  %k'
print -P '%K{33}          %K{25}  %k'
print -P '%K{33}          %K{25} %k  %F{231}%BBAYQUANT%b%f'
