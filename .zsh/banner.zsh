# Print the BayQuant mascot (a blue cube with eyes) with the name beside it.
# Source this from ~/.zshrc to show it on every new terminal.
print -P '  %F{117}██████████%f'
print -P ' %F{117}██████████%F{25}█%f'
print -P '%F{33}██████████%F{25}██%f'
print -P '%F{33}██%F{231}██%F{33}██%F{231}██%F{33}██%F{25}██%f'
print -P '%F{33}██████████%F{25}██%f'
print -P '%F{33}██████████%F{25}█%f  %F{231}%BBAYQUANT%b%f'
